    const members = INITIAL_PEOPLE.filter(p => teamCart.includes(p.id));
    if (members.length === 0) return { synergyScore: 0, sharedProjects: 0, coveredSkills: [], missingSkills: ['Java', 'RAG', 'GraphDB', 'Nuxt'] };

    // 함께 수행한 프로젝트 수 확인 (정규화 켜져 있을 때만 정확히 잡힘)
