        {/* --- 2. 중앙 메인 그래프 캔버스 (인물 카드 + 프로젝트 허브 + SVG 엣지) --- */}
        <main className="flex-1 relative bg-[#F4F4F1] overflow-hidden">
          {/* 미세 도트 그리드 배경 (엔터프라이즈 캔버스 스타일) */}
          <div 
            className="absolute inset-0 opacity-40 pointer-events-none"
            style={{
              backgroundImage: 'radial-gradient(#A1A1AA 1px, transparent 1px)',
              backgroundSize: '20px 20px'
            }}
          />

          {/* 상단 플로팅 상태 배너 (정규화 비교 안내 & 이탈 경고) */}
          <div className="absolute top-4 left-4 right-4 flex items-start justify-between pointer-events-none z-20">
            <div className="bg-white/95 backdrop-blur border border-[#D4D4D0] px-3.5 py-2 rounded shadow-sm pointer-events-auto max-w-xl">
              {isNormalized ? (
                <div className="flex items-center gap-2 text-xs">
                  <span className="w-2 h-2 rounded-full bg-emerald-600 shrink-0" />
                  <span>
                    <strong>Jev 엔티티 정규화 활성:</strong> 서로 다르게 적힌 <code className="bg-[#F2F2EE] px-1 py-0.5 rounded font-mono text-[11px]">"A은행 차세대 구축"</code>, <code className="bg-[#F2F2EE] px-1 py-0.5 rounded font-mono text-[11px]">"A은행 차세대 PJT"</code>, <code className="bg-[#F2F2EE] px-1 py-0.5 rounded font-mono text-[11px]">"A은행 차세대 시스템"</code>이 단일 표준 프로젝트 노드로 묶여 <strong>김현우·이지은·정민호의 동료 관계</strong>가 복원되었습니다.
                  </span>
                </div>
              ) : (
                <div className="flex items-center gap-2 text-xs text-[#991B1B]">
                  <AlertTriangle className="w-4 h-4 shrink-0" />
                  <span>
                    <strong>정규화 해제 상태 (기존 자유기술):</strong> 각자 프로젝트명을 다르게 적어 같은 고객사 프로젝트를 수행했음에도 그래프 연결이 끊어져 있습니다.
                  </span>
                </div>
              )}
            </div>

            {/* 이탈 시뮬레이션 경고 배너 */}
            {busFactorAlert && (
              <div className="bg-[#FEF2F2] border border-[#FECACA] text-[#991B1B] px-4 py-2.5 rounded shadow-sm pointer-events-auto max-w-sm">
                <div className="text-xs font-bold flex items-center justify-between">
                  <span>⚠️ [{busFactorAlert.person.name}] 이탈 시 고립 위험 감지</span>
                  <button onClick={() => setRemovedPersonId(null)} className="text-[11px] underline ml-2">닫기</button>
                </div>
                <div className="text-[11px] mt-1 space-y-0.5">
                  <div>• <strong>위험 도메인:</strong> {busFactorAlert.isolatedClient}</div>
                  <div>• <strong>희소 기술 공백:</strong> {busFactorAlert.endangeredSkills.join(', ') || '없음'}</div>
                  <div className="pt-1 text-[#18181B] font-medium">
                    👉 <strong>추천 인수인계자 (동일 프로젝트):</strong> {busFactorAlert.backups.map(b => b.name).join(', ')}
                  </div>
                </div>
              </div>
            )}
          </div>

          {/* --- SVG 연결선(Edge) 레이어 --- */}
          <svg className="w-full h-full absolute inset-0 pointer-events-none">
            <defs>
              <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                <path d="M 0 1 L 10 5 L 0 9 z" fill="#71717A" />
              </marker>
            </defs>

            {/* 1) 인재 -> 표준 프로젝트 연결선 (정규화 ON 일 때) */}
            {isNormalized && filteredPeople.map(person => {
              const targetPrj = PROJECTS.find(pr => pr.id === person.normProject);
              if (!targetPrj) return null;
              const isLowConf = person.jevConf < 0.65 && !approvedLowConf;
              const isRemoved = removedPersonId === person.id;

              return (
                <g key={`edge-${person.id}-${targetPrj.id}`}>
                  <line
                    x1={person.x}
                    y1={person.y}
                    x2={targetPrj.x}
                    y2={targetPrj.y}
                    stroke={isRemoved ? '#EF4444' : isLowConf ? '#D97706' : '#52525B'}
                    strokeWidth={selectedPersonId === person.id ? 2.2 : 1.4}
                    strokeDasharray={isRemoved ? '4 4' : isLowConf ? '3 3' : 'none'}
                    opacity={isRemoved ? 0.35 : 0.75}
                  />
                  {/* 엣지 라벨 (Jev 확신도 표시) */}
                  <rect
                    x={(person.x + targetPrj.x) / 2 - 42}
                    y={(person.y + targetPrj.y) / 2 - 10}
                    width="84"
                    height="18"
                    rx="3"
                    fill="#FFFFFF"
                    stroke="#D4D4D0"
                  />
                  <text
                    x={(person.x + targetPrj.x) / 2}
                    y={(person.y + targetPrj.y) / 2 + 2}
                    textAnchor="middle"
                    className="text-[10px] font-mono fill-[#52525B]"
                  >
                    {isLowConf ? `검수대기 (${person.jevConf})` : `참여 (Jev ${person.jevConf})`}
                  </text>
                </g>
              );
            })}

            {/* 2) 드림팀 카트에 담긴 인원끼리 과거 같은 프로젝트 수행 시 '협업 시너지' 연결선 표시 */}
            {isNormalized && teamCart.length >= 2 && (
              (() => {
                const cartMembers = filteredPeople.filter(p => teamCart.includes(p.id));
                const lines = [];
                for (let i = 0; i < cartMembers.length; i++) {
                  for (let j = i + 1; j < cartMembers.length; j++) {
                    if (cartMembers[i].normProject === cartMembers[j].normProject) {
                      lines.push(
                        <g key={`synergy-${cartMembers[i].id}-${cartMembers[j].id}`}>
                          <line
                            x1={cartMembers[i].x}
                            y1={cartMembers[i].y}
                            x2={cartMembers[j].x}
                            y2={cartMembers[j].y}
                            stroke="#059669"
                            strokeWidth="2.5"
                            strokeDasharray="6 4"
                          />
                          <rect
                            x={(cartMembers[i].x + cartMembers[j].x) / 2 - 38}
                            y={(cartMembers[i].y + cartMembers[j].y) / 2 - 9}
                            width="76"
                            height="18"
                            rx="9"
                            fill="#ECFDF5"
                            stroke="#059669"
                          />
                          <text
                            x={(cartMembers[i].x + cartMembers[j].x) / 2}
                            y={(cartMembers[i].y + cartMembers[j].y) / 2 + 3}
                            textAnchor="middle"
                            className="text-[10px] font-bold fill-[#065F46]"
                          >
                            동료 시너지 ✓
                          </text>
                        </g>
                      );
                    }
                  }
                }
                return lines;
              })()
            )}
          </svg>

          {/* --- 중앙 프로젝트 허브 카드 노드들 --- */}
          {PROJECTS.map(prj => {
            // 이 프로젝트에 연결된 인원 수
            const connectedCount = isNormalized 
              ? INITIAL_PEOPLE.filter(p => p.normProject === prj.id).length 
              : 1;

            return (
              <div
                key={prj.id}
                style={{ left: prj.x, top: prj.y }}
                className="absolute -translate-x-1/2 -translate-y-1/2 w-64 bg-white border-2 border-[#18181B] rounded-md shadow-sm p-3.5 z-10"
              >
                <div className="flex items-center justify-between text-[10px] font-mono text-[#52525B] mb-1">
                  <span className="flex items-center gap-1 font-bold text-[#18181B]">
                    <Building2 className="w-3 h-3" /> {prj.client}
                  </span>
                  <span>{prj.period}</span>
                </div>

                <div className="text-xs font-bold text-[#18181B] mb-2">
                  {isNormalized ? prj.name : `${prj.rawVariants[0]} (미정규화)`}
                </div>

                {/* 묶인 표기 변형 보여주기 */}
                {isNormalized && (
                  <div className="bg-[#F8F8F6] border border-[#E4E4E0] rounded p-1.5 mb-2">
                    <div className="text-[10px] text-[#71717A] mb-1">통합된 자유기술 표기 ({prj.rawVariants.length}건):</div>
                    <div className="flex flex-wrap gap-1">
                      {prj.rawVariants.map((v, i) => (
                        <span key={i} className="text-[10px] font-mono bg-white border border-[#D4D4D0] px-1 rounded text-[#52525B]">
                          "{v}"
                        </span>
                      ))}
                    </div>
                  </div>
                )}

                <div className="flex items-center justify-between text-[11px] pt-1 border-t border-[#E4E4E0]">
                  <div className="flex gap-1">
                    {prj.reqSkills.map(s => (
                      <span key={s} className="text-[10px] font-mono bg-[#F2F2EE] px-1.5 py-0.5 rounded text-[#18181B]">
                        {s}
                      </span>
                    ))}
                  </div>
                  <span className="font-mono font-bold text-xs">
                    {connectedCount}명 연결
                  </span>
                </div>
              </div>
            );
          })}

          {/* --- 인물(Person) 얼굴 아바타 카드 노드들 --- */}
          {filteredPeople.map(person => {
            const isSelected = selectedPersonId === person.id;
            const inTeamCart = teamCart.includes(person.id);
            const isRemoved = removedPersonId === person.id;

            // 상태 뱃지 스타일
            const statusBadge = {
              Available: { label: '가용 가능', cls: 'bg-emerald-50 text-emerald-800 border-emerald-300' },
              RollOffSoon: { label: '2주 후 종료', cls: 'bg-amber-50 text-amber-800 border-amber-300' },
              Busy: { label: '투입 중', cls: 'bg-zinc-100 text-zinc-600 border-zinc-300' }
            }[person.status];

            return (
              <div
                key={person.id}
                onClick={() => {
                  setSelectedPersonId(person.id);
                  setRightTab('profile');
                }}
                style={{ left: person.x, top: person.y }}
                className={`absolute -translate-x-1/2 -translate-y-1/2 w-56 bg-white rounded-md p-3 cursor-pointer transition-all z-10 ${
                  isRemoved 
                    ? 'opacity-40 border-2 border-dashed border-red-500 grayscale' 
                    : isSelected 
                      ? 'border-2 border-[#18181B] shadow-md ring-4 ring-black/5' 
                      : 'border border-[#D4D4D0] hover:border-[#18181B] shadow-sm'
                }`}
              >
                {/* 팀 빌딩 카트 담기 체크 버튼 */}
                <button
                  onClick={(e) => {
                    e.stopPropagation();
                    toggleTeamMember(person.id);
                    setRightTab('teambuilder');
                  }}
                  title="드림팀 조합 시뮬레이터에 추가/제거"
                  className={`absolute -top-2 -right-2 w-6 h-6 rounded-full flex items-center justify-center text-xs border transition-colors ${
                    inTeamCart 
                      ? 'bg-[#059669] text-white border-[#059669]' 
                      : 'bg-white text-[#52525B] border-[#D4D4D0] hover:border-[#18181B]'
                  }`}
                >
                  {inTeamCart ? '✓' : '+'}
                </button>

                {/* 상단: 아바타 + 이름/직무 */}
                <div className="flex items-center gap-2.5">
                  <img 
                    src={person.avatar} 
                    alt={person.name} 
                    className="w-10 h-10 rounded-full object-cover border border-[#E4E4E0] shrink-0"
                  />
                  <div className="min-w-0 flex-1">
                    <div className="flex items-center justify-between">
                      <span className="text-xs font-bold text-[#18181B] truncate">{person.name}</span>
                      <span className={`text-[10px] px-1.5 py-0.5 rounded border font-medium ${statusBadge.cls}`}>
                        {statusBadge.label}
                      </span>
                    </div>
                    <div className="text-[11px] text-[#71717A] truncate">
                      {person.dept} · {person.exp}
                    </div>
                  </div>
                </div>

                {/* 중간: 보유 기술 태그 */}
                <div className="flex flex-wrap gap-1 mt-2.5">
                  {person.skills.map(skill => (
                    <span 
                      key={skill} 
                      className={`text-[10px] font-mono px-1.5 py-0.5 rounded border ${
                        selectedSkills.includes(skill)
                          ? 'bg-[#18181B] text-white border-[#18181B]'
                          : 'bg-[#F8F8F6] text-[#52525B] border-[#E4E4E0]'
                      }`}
                    >
                      {skill}
                    </span>
                  ))}
                </div>

                {/* 하단: 자유기술 원문 vs 정규화 상태 */}
                <div className="mt-2 pt-2 border-t border-[#F2F2EE] flex items-center justify-between text-[10px] text-[#71717A]">
                  <span className="truncate">이력: "{person.rawProject}"</span>
                  <span className="font-mono text-[#18181B] font-semibold shrink-0 ml-1">
                    Jev {person.jevConf}
                  </span>
                </div>
              </div>
            );
          })}
        </main>

        {/* --- 3. 우측 상세 & HR 액션 패널 (3개 탭 전환) --- */}
        <aside className="w-80 bg-white border-l border-[#E4E4E0] flex flex-col shrink-0 z-10">
          
          {/* 탭 네비게이션 */}
          <div className="grid grid-cols-3 border-b border-[#E4E4E0] bg-[#F8F8F6] text-xs font-medium">
            <button
              onClick={() => setRightTab('profile')}
              className={`py-2.5 border-b-2 transition-colors ${
                rightTab === 'profile' ? 'border-[#18181B] text-[#18181B] bg-white font-bold' : 'border-transparent text-[#71717A]'
              }`}
            >
              인재 상세/근거
            </button>
            <button
              onClick={() => setRightTab('teambuilder')}
              className={`py-2.5 border-b-2 transition-colors ${
                rightTab === 'teambuilder' ? 'border-[#18181B] text-[#18181B] bg-white font-bold' : 'border-transparent text-[#71717A]'
              }`}
            >
              팀 빌더 ({teamCart.length})
            </button>
            <button
              onClick={() => setRightTab('jev')}
              className={`py-2.5 border-b-2 transition-colors ${
                rightTab === 'jev' ? 'border-[#18181B] text-[#18181B] bg-white font-bold' : 'border-transparent text-[#71717A]'
              }`}
            >
              정규화 검수
            </button>
          </div>

          {/* 탭 1: 선택된 인재 상세 프로필 & 관계 경로 근거 */}
          {rightTab === 'profile' && (
            <div className="p-4 flex-1 overflow-y-auto space-y-4">
              <div className="flex items-center gap-3 pb-3 border-b border-[#E4E4E0]">
                <img 
                  src={selectedPerson.avatar} 
                  alt={selectedPerson.name} 
                  className="w-14 h-14 rounded-full object-cover border border-[#D4D4D0]"
                />
                <div>
                  <h2 className="text-base font-bold text-[#18181B]">{selectedPerson.name}</h2>
                  <p className="text-xs text-[#52525B]">{selectedPerson.dept} · {selectedPerson